{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "K12 Video Runner",
  "description": "Chọn và đánh dấu hoàn thành bài học K12 từ sidebar của Chrome.",
  "version": "1.2.1",
  "action": {
    "default_title": "K12 Video Runner"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://hcm.k12online.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://hcm.k12online.vn/*"
  ]
}
