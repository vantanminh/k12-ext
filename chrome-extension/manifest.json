{
  "manifest_version": 3,
  "name": "K12 Video Runner",
  "description": "Hiển thị nút Chạy tiến trình trên trang video của hcm.k12online.vn và gửi yêu cầu hoàn tất video.",
  "version": "1.0.0",
  "action": {
    "default_title": "K12 Video Runner"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hcm.k12online.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://hcm.k12online.vn/*"
  ]
}