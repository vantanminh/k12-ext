# Copy to server/.env. Keys are read only by the Rust process.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional admin token: the extension's "Token quản trị" field. Skips daily quota.
K12_SERVER_TOKEN=
K12_SERVER_PORT=3210

# Email one-time-code login. Codes are sent through Resend (https://resend.com);
# K12_EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
K12_EMAIL_FROM=K12 AI <login@your-domain.example>
# Local only: print login codes in this console instead of emailing them.
# Ignored when the server listens publicly (Railway PORT or K12_SERVER_PUBLIC=1).
K12_DEV_LOG_OTP=0
# Postgres for users/sessions/quota. Without it everything is in memory and
# is lost on restart. On Railway, reference the Postgres plugin's DATABASE_URL.
DATABASE_URL=
# Successful AI solves per user per day (resets at 00:00 Vietnam time).
K12_DAILY_SOLVE_LIMIT=30
# OpenAI calls processed at the same time across all users.
K12_MAX_CONCURRENT=2
